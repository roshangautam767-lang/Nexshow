# Phase 3 - TMDB (https://www.themoviedb.org/settings/api). Either the v3 API key or the v4 read access token works.
TMDB_API_KEY=

# Phase 4 - Supabase (Project settings > API). The service role key must NEVER be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 7 - Razorpay (test mode first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Phase 10 - WhatsApp Business Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
